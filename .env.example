# ---- Backend (set these in Vercel → Settings → Environment Variables) ----
# Supabase Postgres connection string.
# Local/drizzle-kit: direct connection  postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
# Vercel (serverless): Transaction pooler  postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:your-database-password@db.your-project-ref.supabase.co:5432/postgres

# Supabase project URL and publishable key (Settings → API)
# Admin access is granted via your user's app_metadata: {"role": "admin"} (Supabase dashboard).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# ---- Frontend (exposed to the browser — both are safe to publish) ----
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
