# Copy to .env locally, and set the same values in Vercel → Settings → Environment Variables
# NEVER commit a real .env file.

# --- Backend (server/_core/env.ts) ---
DATABASE_URL=mysql://USER:PASSWORD@HOST:PORT/DATABASE
JWT_SECRET=replace-with-a-random-32-char-secret
VITE_APP_ID=your-manus-app-id
OAUTH_SERVER_URL=https://your-manus-oauth-server-url
OWNER_OPEN_ID=your-manus-owner-open-id
BUILT_IN_FORGE_API_URL=https://your-forge-api-url
BUILT_IN_FORGE_API_KEY=your-forge-api-key
NODE_ENV=production

# --- Frontend (client/src/const.ts — needed at BUILD time) ---
VITE_OAUTH_PORTAL_URL=https://your-manus-oauth-portal-url
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
